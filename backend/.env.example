# ── Server ─────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── MySQL Database ──────────────────────────────────────────
# Local:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=breachwyre_db
DB_PORT=3306
DB_SSL=false

# Cloud (Aiven/Railway) — set DB_SSL=true and fill in cloud values:
# DB_HOST=mysql-xxx.aivencloud.com
# DB_PORT=15432
# DB_USER=avnadmin
# DB_PASSWORD=your-aiven-password
# DB_SSL=true

# ── Redis ───────────────────────────────────────────────────
# Local:
REDIS_URL=redis://localhost:6379
# Cloud (Upstash): REDIS_URL=rediss://default:password@host:port

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────
# Local:
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://breachwyre.vercel.app

